# =================================
# AI News Ecosystem — Backend config
# Copy to .env and fill in your own values.  NEVER commit the real .env.
# =================================

# ── Database ──────────────────────────────────────────────
# SQLite for local dev; a postgres:// URL in production (auto-rewritten to psycopg v3).
DATABASE_URL=sqlite:///./news_db.sqlite

# ── Google OAuth (Google Cloud Console → Credentials) ─────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Gemini (Google AI Studio → API keys) ─────────────────
GEMINI_API_KEY=your-gemini-api-key
# Optional model override. Defaults to the auto-updating flash alias.
# Pin a version (e.g. gemini-2.0-flash) only if you need reproducibility.
GEMINI_MODEL=gemini-flash-latest

# ── NewsAPI (optional — RSS feeds work without it) ────────
NEWS_API_KEY=

# ── JWT ───────────────────────────────────────────────────
# Must be >= 32 chars. Generate one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application ───────────────────────────────────────────
APP_NAME=NewsAI
DEBUG=true
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Dev-only mock login (triple-guarded: only works with DEBUG=true + ENVIRONMENT=development).
DEV_LOGIN_ENABLED=true

# ── AI behaviour ──────────────────────────────────────────
# Articles are summarized on demand (when a user opens one). Set to true ONLY
# with generous/paid Gemini quota to also pre-summarize new articles in the
# background — on the free tier that pre-warming exhausts the daily quota.
PRESUMMARIZE_ENABLED=false

# ── Optional infra ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
